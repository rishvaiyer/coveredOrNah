{
  "name": "formulary-finder-pilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "test": "npm run build",
    "db:migrate": "tsx scripts/migrate.ts",
    "cms:import": "tsx scripts/import-cms-medicare.ts",
    "cms:check": "tsx scripts/check-cms-medicare.ts",
    "cms:test": "tsx --test scripts/cms-medicare-utils.test.ts",
    "uhc:qhp:test": "tsx --test uhc-nj-qhp.test.ts",
    "aetna:familycare:test": "tsx --test src/server-data/aetna-nj-familycare.test.ts",
    "uhc:community:test": "tsx --test src/server-data/uhc-nj-community.test.ts",
    "fidelis:nj:test": "tsx --test src/server-data/fidelis-nj-familycare.test.ts",
    "formulary:gaps": "tsx scripts/audit-formulary-gaps.ts",
    "formulary:gaps:test": "tsx --test scripts/audit-formulary-gaps.test.ts",
    "horizon:classic:test": "tsx --test scripts/horizon-classic.test.ts",
    "formulary-data": "tsx tools/public-formulary-cli/index.ts",
    "formulary-data:typecheck": "tsc -p tools/public-formulary-cli/tsconfig.json",
    "formulary-data:test": "tsx --test tools/public-formulary-cli/client.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
